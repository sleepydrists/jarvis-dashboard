# =============================================================================
# JARVIS Dashboard — Environment Variables
# Copy to `.env` for local development:  copy .env.example .env
# =============================================================================

# --- Backend (local .env or Render/Railway dashboard) ------------------------

# OpenAI — required for chat and AI estimator
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Server
PORT=3001
HOST=0.0.0.0

# Lead intake secret — required in production; hgjunkremoval.com sends this header
LEAD_WEBHOOK_SECRET=your-webhook-secret-here

# Comma-separated browser origins allowed to call the API (CORS)
# Include your Vercel dashboard URL after deploy, e.g. https://jarvis-dashboard.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hgjunkremoval.com,https://www.hgjunkremoval.com

# Persistent lead storage directory
# Local default: server/data/  |  Render/Railway: /var/data (mount a disk/volume)
DATA_DIR=

# --- Frontend (Vercel project settings only — prefix VITE_) ------------------

# Production API URL — leave empty locally (Vite proxies /api → localhost:3001)
# Example: https://jarvis-api.onrender.com
VITE_API_URL=
